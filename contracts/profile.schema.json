{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "udyam/profile",
  "title": "BusinessProfile",
  "description": "Structured profile the advisor extracts. Enums come from the case data (docs/data-dictionary.md). Only fields known at lead creation belong here.",
  "type": "object",
  "properties": {
    "businessName": {"type": "string"},
    "businessType": {"type": "string", "description": "Free text; case data uses e.g. Kirana store, Dental clinic, Restaurant chain"},
    "segment": {"enum": ["Micro retail & services", "Professional offices", "Small manufacturers", "Small multi-site businesses"]},
    "city": {"type": "string"},
    "cityTier": {"enum": [1, 2]},
    "preferredLanguage": {"enum": ["Bengali", "English", "Gujarati", "Hindi", "Kannada", "Malayalam", "Marathi", "Punjabi", "Tamil", "Telugu"]},
    "employeeCount": {"type": "integer", "minimum": 1},
    "numSites": {"type": "integer", "minimum": 1},
    "annualTurnoverBand": {"enum": ["< 40 lakh", "40 lakh - 1.5 cr", "1.5 - 5 cr", "5 - 25 cr", "25 - 100 cr"]},
    "hasGstin": {"type": "boolean"},
    "gstin": {"type": "string"},
    "hasUdyam": {"type": "boolean"},
    "udyamNumber": {"type": "string"},
    "currentInternet": {"enum": ["Business broadband", "Home broadband", "Leased line", "Mixed per site", "Mobile hotspot"]},
    "currentProvider": {"enum": ["Accel", "Accel (mobile only)", "Competitor A", "Competitor B", "Local ISP"]},
    "monthlyTelecomSpendInr": {"type": "number", "minimum": 0},
    "productsOfInterest": {"type": "array", "items": {"type": "string", "pattern": "^P[0-9]{2}$"}}
  },
  "additionalProperties": false
}
