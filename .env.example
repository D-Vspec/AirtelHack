# Copy to .env (never commit .env). Defaults work for local docker compose.
POSTGRES_USER=udyam
POSTGRES_PASSWORD=udyam
POSTGRES_DB=udyam
# Each Go service connects as its own role (svc_<name>, infra/postgres/roles.sql) with this password
SERVICE_DB_PASSWORD=udyam-svc

# Host-side tools (go run, tests) use these; containers get their own values from docker-compose.yml
DATABASE_URL=postgres://udyam:udyam@localhost:5432/udyam?sslmode=disable
KAFKA_BROKERS=localhost:9092

# Advisor (Phase 3). Pick one provider and set its key.
LLM_PROVIDER=gemini            # gemini | anthropic | openai | deepseek
# LLM_MODEL is optional; the provider default is used when empty
LLM_MODEL=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# DeepSeek: LLM_MODEL defaults to deepseek-flash (V4.1 Flash)
DEEPSEEK_API_KEY=

# KYC rules (Phase 4)
KYC_REFERENCE_DATE=2026-07-15
KYC_DOC_RETENTION_DAYS=30       # document images are deleted after this, or at a final decision
KYC_ABANDON_AFTER_MINUTES=1440    # unfinished KYC gets a resume link after this
KYC_RESUME_BASE_URL=http://localhost:3000/kyc/resume/

# Demo order simulator (Phase 5): seconds an order waits in each install stage
SIM_STEP_SECONDS=8

# Gateway: back-office routes need X-Admin-Token (change it for anything but a local demo); per-IP requests/second
ADMIN_TOKEN=demo-admin-token
RATE_LIMIT_RPS=30

# Frontends
NEXT_PUBLIC_API_URL=http://localhost:8080/api
EXPO_PUBLIC_API_URL=http://localhost:8080/api
